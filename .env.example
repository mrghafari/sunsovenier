# Environment Configuration for Momtaz Chemical Platform (test)
# Copy this file to .env for development or configure these variables for production deployment

# Production Domain Configuration
FRONTEND_URL=https://www.momtazchem.com

# Database Configuration
DATABASE_URL=postgresql://momtaz:momtaz_password@db:5432/momtaz_chem
POSTGRES_USER=momtaz
POSTGRES_PASSWORD=momtaz_password
POSTGRES_DB=momtaz_chem

# Email Configuration
SMTP_HOST=smtp.zoho.com
SMTP_PORT=587
SMTP_USER=your_email@momtazchem.com
SMTP_PASS=your_smtp_password

# Session Configuration
SESSION_SECRET=your_session_secret_key

# AWS S3 Storage
AWS_ACCESS_KEY_ID_NEW=your-aws-access-key
AWS_SECRET_ACCESS_KEY_NEW=your-aws-secret-key
AWS_CREDENTIALS_ENCRYPTION_KEY=your-encryption-key-for-credentials

# OAuth - Google
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# OAuth - Facebook
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret

# FIB Bank Credentials (encrypted in database)
FIB_CREDENTIALS_ENCRYPTION_KEY=your-fib-encryption-key

# Application
NODE_ENV=production
PORT=5000

# Note: 
# 1- In development, the system will auto-detect the current Replit domain
# 2- In production, set FRONTEND_URL to https://www.momtazchem.com
# 3- All password reset links and email communications will use the configured domain
